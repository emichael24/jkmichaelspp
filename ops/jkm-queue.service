[Unit]
Description=JK Michaels Laravel queue worker
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=jkmichaelspm.com_8glivfes07m
Group=psacln
WorkingDirectory=/var/www/vhosts/jkmichaelspm.com/app.jkmichaelspm.com
ExecStart=/opt/plesk/php/8.2/bin/php artisan queue:work database --sleep=3 --tries=3 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=1G

[Install]
WantedBy=multi-user.target
